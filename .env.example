# Variables de entorno para MySQL y para la conexión de Flask
# Copia este archivo como .env y completa las claves. El .env se queda en local.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=erp
MYSQL_USER=
MYSQL_PASSWORD=

# El HOST es el nombre del SERVICIO en docker-compose.yml, no localhost
DB_HOST=servidor_db_2
# Puerto INTERNO de MySQL (el 3308 es el que se publica hacia tu PC para Workbench)
DB_PORT=3306
